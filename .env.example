# Run locally in demo mode with no variables. Demo mode uses browser storage + mock OCR/LLM.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (production persistence + auth + storage)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key

# Providers
OCR_PROVIDER=mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Storage
SUPABASE_STORAGE_BUCKET=documents
MAX_FILE_SIZE_MB=10
MAX_BATCH_FILES=20

# App limits
FREE_MONTHLY_LIMIT=20
STARTER_MONTHLY_LIMIT=500
BUSINESS_MONTHLY_LIMIT=2000
